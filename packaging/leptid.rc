// Leptid — Windows resource file (compiled into the exe by windres / RC.exe).
// Gives the executable its icon and version information.
#include <windows.h>

1 ICON "assets\\icons\\leptid.ico"

1 VERSIONINFO
FILEVERSION     0, 1, 2, 0
PRODUCTVERSION  0, 1, 2, 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Leptid Project"
      VALUE "FileDescription",  "Leptid - 2D Animation Application"
      VALUE "FileVersion",      "0.1.2"
      VALUE "InternalName",     "leptid"
      VALUE "OriginalFilename", "leptid.exe"
      VALUE "ProductName",      "Leptid"
      VALUE "ProductVersion",   "0.1.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
