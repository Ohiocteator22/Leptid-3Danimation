# Leptid — embed brush tip + icon PNGs into one generated source (script mode).
# usage: cmake -DBIN2CPP=<exe> -DOUT=<file> -DSRC_DIR=<root> -P embed_assets.cmake
file(GLOB tips ${SRC_DIR}/assets/brushes/tip_*.png)
file(GLOB icons ${SRC_DIR}/assets/icons/leptid_*.png)
list(SORT tips)
list(SORT icons)
file(WRITE ${OUT} "// generated by embed_assets.cmake - do not edit\n")
foreach(f ${tips} ${icons})
    get_filename_component(b ${f} NAME_WE)
    execute_process(COMMAND ${BIN2CPP} ${f} ${b}_png OUTPUT_VARIABLE chunk OUTPUT_STRIP_TRAILING_WHITESPACE)
    file(APPEND ${OUT} "${chunk}\n")
endforeach()
message(STATUS "embedded ${tips} tips + icons into ${OUT}")
